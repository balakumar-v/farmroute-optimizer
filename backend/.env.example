# ==============================================================================
# FarmRoute Optimizer - Backend Environment Configuration
# ==============================================================================
# Copy this file to backend/.env (which is git-ignored):
#   Copy-Item backend\.env.example backend\.env
# Start the FastAPI server with:
#   uvicorn main:app --reload --port 8000 --env-file .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SECURITY (Required for persistent storage and farmer portal)
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string (Project -> Connection Details -> URI):
# Example: postgresql://username:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret every admin route requires (sent in headers as "Authorization: Bearer <ADMIN_TOKEN>").
# Required for issuing PINs and publishing plans.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Secret used to sign farmer JWT tokens. If unset, tokens expire across server restarts.
FARMROUTE_SECRET=change-me-to-another-long-random-string

# Number dialed when farmer clicks "Call your FPO" in the Farmer PWA (E.164 format)
FPO_PHONE=+911234567890

# Admin auth bypass for local testing only: "off" opens admin endpoints without token.
# ADMIN_AUTH=off

# Allowed CORS origins for frontend, comma-separated (unset = allow all origins for local dev)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. NOTIFICATION CHANNELS & PROVIDERS
# ------------------------------------------------------------------------------
# OTP Channel strategy: "both" (default, sends OTP on SMS AND WhatsApp), "sms", or "whatsapp"
OTP_CHANNEL=both

# SMS Provider selection: "dry" (default: logs only, no credentials needed) | "twilio" | "msg91"
SMS_PROVIDER=dry

# WhatsApp Provider selection: "dry" (default: logs only, no credentials needed) | "meta" | "twilio"
WHATSAPP_PROVIDER=dry

# Default country code added to mobile numbers entered without "+" (India is 91)
DEFAULT_COUNTRY_CODE=91

# Demo mode: return OTP code in API response (only works when provider is dry, for testing/demos)
NOTIFY_DEMO_SHOW_OTP=on

# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API CONFIGURATION (Required when WHATSAPP_PROVIDER=meta)
# ------------------------------------------------------------------------------
# Meta User/System Access Token (from Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=your-meta-access-token-here

# Meta Phone Number ID (from Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id-here

# Meta WhatsApp Graph API Version (defaults to v20.0)
WHATSAPP_API_VERSION=v20.0

# Template name for farmer plan updates and welcome messages (must be approved in Meta Business Manager)
# Contains 1 body variable {{1}} for the update text in each supported language (en, te, hi, ta)
WHATSAPP_TEMPLATE=farmroute_plan_update

# Template name for OTP verification messages (authentication category)
# Authentication template has 1 variable {{1}} for the 6-digit code and a Copy-Code button
# Note: For initial connectivity test before custom templates are approved, set to "hello_world"
WHATSAPP_OTP_TEMPLATE=farmroute_otp

# OTP template button type: "copy_code" (standard for authentication templates) or "off"
WHATSAPP_OTP_BUTTON=copy_code

# ------------------------------------------------------------------------------
# 4. TWILIO CONFIGURATION (Required when SMS_PROVIDER=twilio or WHATSAPP_PROVIDER=twilio)
# ------------------------------------------------------------------------------
# Twilio Account SID and Auth Token (from Twilio Console)
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# Twilio SMS sender: Phone number (+1...) or Messaging Service SID (MG...)
TWILIO_SMS_FROM=your-twilio-phone-number-here

# Twilio WhatsApp sender: e.g. whatsapp:+14155238886 (Twilio Sandbox) or your approved number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# 5. MSG91 CONFIGURATION (Required when SMS_PROVIDER=msg91 for India DLT SMS)
# ------------------------------------------------------------------------------
# MSG91 Auth Key
MSG91_AUTH_KEY=your-msg91-auth-key-here

# MSG91 Template Flow IDs (DLT approved in India)
MSG91_OTP_TEMPLATE_ID=your-msg91-otp-template-id-here
MSG91_UPDATE_TEMPLATE_ID=your-msg91-update-template-id-here

# MSG91 DLT template variable name (defaults to VAR1)
MSG91_VAR=VAR1

# ------------------------------------------------------------------------------
# 6. ROUTING ENGINE CONFIGURATION (Road distances & matrix calculation)
# ------------------------------------------------------------------------------
# ROUTING_PROVIDER=osrm        # osrm | ors | off
# OSRM_BASE_URL=https://router.project-osrm.org
# ORS_API_KEY=
# ROAD_PLANNING=auto           # off = plan on straight lines
# ROAD_MATRIX_MAX_POINTS=200
# FARMROUTE_ROAD_CIRCUITY=1.0

# ------------------------------------------------------------------------------
# 7. FARMER CHANGE-REQUEST CHAT (farmers ask the FPO for a new quantity or time)
# ------------------------------------------------------------------------------
# Farmer change-request chat. Without these two the chat falls back to the plain form (nothing breaks).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=            # no default: pick a small model that follows JSON instructions, and test it on your farmers' languages
# OPENROUTER_TIMEOUT_S=10
# CHANGE_MAX_QTY_KG=5000       # largest quantity a farmer may ask for
# CHANGE_MAX_HOUR=72           # latest deadline (hours from the start of the day) a farmer may ask for
# CHANGE_REQUEST_TTL_H=24      # pending requests expire after this many hours
# CHAT_RATE_PER_HOUR=20        # messages per farmer per hour (per process)
