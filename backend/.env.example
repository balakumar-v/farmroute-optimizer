# Copy to backend/.env (git-ignored) and start with:  uvicorn main:app --reload --port 8000 --env-file .env

# Required. Neon: Project -> Connection details -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret every admin route requires (send as "Authorization: Bearer <token>"). Required for the farmer portal.
# Unset = admin routes open (local dev) and the farmer routes refuse to work.
# ADMIN_TOKEN=change-me-to-a-long-random-string
# Number the farmer app's "Call your FPO" button dials (copied into cards when you publish).
# FPO_PHONE=+911234567890
# ADMIN_AUTH=off   # demos only: opens admin routes with no token; anyone with the URL can issue PINs. Remove before real use.
# Signs farmer login tokens. Set it, or tokens die on every restart.
# FARMROUTE_SECRET=another-long-random-string

# Frontend origins allowed by CORS, comma separated, no trailing slash. Unset = any site (fine for local dev only).
# ALLOWED_ORIGINS=https://farmroute-optimizer-frontend.onrender.com

# Road distances. Defaults: public OSRM server, road matrix planning on.
# ROUTING_PROVIDER=osrm        # osrm | ors | off
# ORS_API_KEY=
# OSRM_BASE_URL=
# ROAD_PLANNING=auto           # off = plan on straight lines
# ROAD_MATRIX_MAX_POINTS=200
# FARMROUTE_ROAD_CIRCUITY=1.0  # used when road lookups are off

# SMS / WhatsApp plan updates. Default "dry" = messages are logged, nothing is sent (no account needed).
# SMS_PROVIDER=dry                  # dry | twilio | msg91
# WHATSAPP_PROVIDER=dry             # dry | meta | twilio
# DEFAULT_COUNTRY_CODE=91
# NOTIFY_DEMO_SHOW_OTP=off          # on: return the SMS code in the response (only with SMS_PROVIDER=dry, demos only)
# twilio:  TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_SMS_FROM=  TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# msg91:   MSG91_AUTH_KEY=  MSG91_OTP_TEMPLATE_ID=  MSG91_UPDATE_TEMPLATE_ID=  MSG91_VAR=VAR1
# meta:    WHATSAPP_TOKEN=  WHATSAPP_PHONE_ID=  WHATSAPP_TEMPLATE=farmroute_plan_update  WHATSAPP_API_VERSION=v20.0

# ---- WhatsApp Cloud API (Meta): verification codes (OTP) + continuous plan updates --------------------------------
# Put the REAL values in backend/.env only (it is git-ignored). Never paste the token into code or commit it.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=<your Meta access token>        # a temporary token expires in ~24h; use a System User token for real use
# WHATSAPP_PHONE_ID=514959798361773              # the Phone number ID from Meta > WhatsApp > API Setup
# OTP_CHANNEL=whatsapp                           # sms (default) | whatsapp | both -- where the login/verify code goes
# WHATSAPP_OTP_TEMPLATE=farmroute_otp            # approved AUTHENTICATION template (body {{1}} = code, copy-code button)
# WHATSAPP_OTP_BUTTON=on                         # off if your OTP template has no copy-code button
# WHATSAPP_TEMPLATE=farmroute_plan_update        # approved UTILITY template, one body variable {{1}}
# WHATSAPP_MODE=template                         # text = plain text, only delivered within 24h of the farmer messaging you
