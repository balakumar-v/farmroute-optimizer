# Copy to backend/.env and start the API with:
#   uvicorn main:app --reload --port 8000 --env-file .env

# Required. This value matches the database in ../docker-compose.yml.
# For a hosted Postgres such as Neon, paste its connection string and keep ?sslmode=require.
DATABASE_URL=postgresql://farmroute:farmroute@localhost:5432/farmroute

# Optional. Comma-separated frontend origins allowed by CORS (default: any origin).
# ALLOWED_ORIGINS=http://localhost:5173

# Optional. Road data (see backend/roads.py).
# ROUTING_PROVIDER=osrm          # osrm | ors | off  (default: ors if ORS_API_KEY is set, else osrm)
# ORS_API_KEY=
# OSRM_BASE_URL=                 # your own OSRM server instead of the public demo server
# ROAD_PLANNING=auto             # off = plan on straight lines instead of road distances
# ROAD_MATRIX_MAX_POINTS=200
# FARMROUTE_ROAD_CIRCUITY=1.0    # road-km / straight-km factor used when road distances are off
